# 复制为 .env 后填写。本文件可以提交，.env 不应提交。
POSTGRES_DB=campus_assistant
POSTGRES_USER=campus
POSTGRES_PASSWORD=replace_with_your_local_password
POSTGRES_HOST=127.0.0.1

# 宿主机端口；端口被占用时可以修改，Compose 始终仅绑定 127.0.0.1。
APP_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# 下列本机地址供 .venv 开发使用；Compose 自动覆盖为 postgres/redis 及容器端口。
# 当前 Compose 的 Redis 没有设置密码，REDIS_PASSWORD 保持空值。
REDIS_HOST=127.0.0.1
REDIS_DB=0
REDIS_PASSWORD=
# Redis 单次连接/读写超时（秒），故障时尽快回退数据库。
REDIS_SOCKET_TIMEOUT=0.3
# 仅详情使用缓存，固定有效期 300 秒；测试会使用独立的随机前缀。
GUIDE_CACHE_PREFIX=campus-assistant:guides:v1

# 必填：运行 python -m scripts.generate_jwt_secret 自动填入本机 .env。
# 首次只使用 Docker 时的生成命令见 README；已有值必须保留。
# 不在示例文件放置可用密钥，也不要提交真实 .env。
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30

# 第五阶段：默认 mock 不收费；本机填写密钥并切换 deepseek 后才会调用真实 API。
MODEL_PROVIDER=mock
MODEL_NAME=deepseek-flash
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_TIMEOUT_SECONDS=30
# 初始输出上限，允许 1～8192；本站单条回复另有 16000 字符限制。
MODEL_MAX_TOKENS=1024
# DeepSeek 固定 stream=true、thinking={"type":"disabled"}，无自动重试。
MOCK_CHUNK_CHARS=32
MOCK_DELAY_SECONDS=0.04
MOCK_FAILURE_AFTER_CHUNKS=2

# 仅缓存已完成的问答；完整历史和生成状态保存在 PostgreSQL。
CHAT_CONTEXT_PREFIX=campus-assistant:context:v1
CHAT_CONTEXT_TTL=600
CHAT_CONTEXT_ROUNDS=6
CHAT_CONTEXT_MAX_CHARS=12000
